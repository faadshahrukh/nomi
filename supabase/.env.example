# Function secrets. Set them with:  supabase secrets set --env-file supabase/.env
# Never commit supabase/.env.  The app never sees any of these.

# Required: your Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...

# Optional.
# INTERPRETER_MODEL=claude-opus-5-5     # the default. A smaller/cheaper model is a product decision; see supabase/README.md
# INTERPRETER_DAILY_LIMIT=200           # AI understandings per user per day
# INTERPRETER_FALLBACKS=1               # 0 turns off the refusal-fallback request parameter
# ALLOWED_ORIGIN=https://app.example    # only needed if a browser app calls the function

# Required for Google sign-in (Google Cloud Console -> Credentials -> OAuth client, type "Web application").
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
