{
  "expo": {
    "name": "Nomi",
    "slug": "nomi",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nomi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.nomi.mobile"
    },
    "android": {
      "package": "app.nomi.mobile",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101D26"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#101D26"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Nomi uses the microphone so you can say what you spent instead of typing it. Audio is turned into text on your phone and is never stored.",
          "speechRecognitionPermission": "Nomi uses speech recognition to turn what you say into text. Nothing you say is saved."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
