# Copy to .env (never commit .env). All EXPO_PUBLIC_* values are visible inside the app bundle, so they must be non-secret.

# From the Supabase dashboard: Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Development only.
# EXPO_PUBLIC_DATA_MODE=demo            # demo | real
# EXPO_PUBLIC_DEV_TOOLS=1               # shows the component gallery in release builds
# EXPO_PUBLIC_TODAY_OVERRIDE=2025-03-15 # pin "today" for reproducible screenshots
